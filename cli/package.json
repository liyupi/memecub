{
  "name": "memecub",
  "version": "0.3.0",
  "description": "Meme search, automatic meme placement and AI meme generation for AI agents and writers: find reaction memes, GIFs and Chinese 表情包 by feeling, insert them into articles, or draw a custom one. CLI and JS client for memecub.com.",
  "type": "module",
  "bin": {
    "memecub": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://memecub.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyupi/memecub.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/liyupi/memecub/issues",
  "author": "Cyber Koi Limited (https://memecub.com)",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "meme",
    "memes",
    "meme-search",
    "reaction-images",
    "gif",
    "mcp",
    "ai-agent",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "cli",
    "表情包",
    "斗图"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "types": "./dist/client.d.ts",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
